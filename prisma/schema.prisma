generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // platform / website administrator
  SALON_ADMIN // manages their own salon(s)
}

enum AccountStatus {
  PENDING   // awaiting admin approval
  ACTIVE    // approved and in good standing
  SUSPENDED // blocked by admin
}

enum SalonStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OwnerSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum SmsCampaignRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role          Role
  accountStatus AccountStatus @default(PENDING) @map("account_status")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedSalons        Salon[]               @relation("SalonOwner")
  bookingsAsCustomer Booking[]            @relation("CustomerBookings")
  ownerSubscriptions OwnerSubscription[]
  campaignRequests   SmsCampaignRequest[] @relation("OwnerCampaignRequests")

  @@map("users")
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String
  description    String?  @db.Text
  priceCents     Int      @map("price_cents")
  currency       String   @default("USD")
  intervalMonths Int      @default(1) @map("interval_months")
  features       Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownerSubscriptions OwnerSubscription[]

  @@map("subscription_plans")
}

model OwnerSubscription {
  id        String                  @id @default(uuid())
  ownerId   String                  @map("owner_id")
  planId    String                  @map("plan_id")
  startsAt  DateTime                @map("starts_at")
  expiresAt DateTime                @map("expires_at")
  status    OwnerSubscriptionStatus @default(ACTIVE)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([ownerId])
  @@index([expiresAt])
  @@index([status])
  @@map("owner_subscriptions")
}

model Salon {
  id             String      @id @default(uuid())
  ownerId        String      @map("owner_id")
  name           String
  slug           String      @unique
  description    String?     @db.Text
  address        String?
  city           String?
  country        String?
  contactPhone   String?     @map("contact_phone")
  contactEmail   String?     @map("contact_email")
  websiteUrl     String?     @map("website_url")
  businessHours  Json?       @map("business_hours")
  status         SalonStatus @default(DRAFT)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  owner            User                  @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  services         Service[]
  bookings         Booking[]
  gallery          GalleryItem[]
  technicians      Technician[]
  promoCodes       PromoCode[]
  campaignRequests SmsCampaignRequest[]

  @@index([name])
  @@index([city])
  @@index([ownerId])
  @@index([status])
  @@map("salons")
}

model Service {
  id          String   @id @default(uuid())
  salonId     String   @map("salon_id")
  name        String
  description String?  @db.Text
  durationMin Int      @map("duration_min")
  priceCents  Int      @map("price_cents")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([salonId])
  @@map("services")
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String?       @map("customer_id")
  guestName   String?       @map("guest_name")
  guestEmail  String?       @map("guest_email")
  guestPhone  String?       @map("guest_phone")
  salonId       String        @map("salon_id")
  serviceId     String        @map("service_id")
  technicianId  String?       @map("technician_id")
  promoCodeId   String?       @map("promo_code_id")
  discountPct   Int?          @map("discount_pct")
  startAt       DateTime      @map("start_at")
  endAt         DateTime      @map("end_at")
  status        BookingStatus @default(PENDING)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer   User?       @relation("CustomerBookings", fields: [customerId], references: [id])
  salon      Salon       @relation(fields: [salonId], references: [id])
  service    Service     @relation(fields: [serviceId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  promoCode  PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([salonId])
  @@index([technicianId])
  @@index([promoCodeId])
  @@index([startAt])
  @@index([status])
  @@index([salonId, startAt])
  @@map("bookings")
}

model GalleryItem {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  url       String   @db.Text
  caption   String?  @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@map("gallery_items")
}

model WebsiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

model Technician {
  id             String   @id @default(uuid())
  salonId        String   @map("salon_id")
  name           String
  phone          String?
  email          String?
  specialization String?  @db.Text
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([salonId])
  @@map("technicians")
}

model PromoCode {
  id             String    @id @default(uuid())
  salonId        String    @map("salon_id")
  code           String    @unique
  campaignName   String?   @map("campaign_name")
  recipientCount Int       @default(0) @map("recipient_count")
  discountPct    Int       @map("discount_pct")
  discountScope  String    @map("discount_scope")
  serviceIds     Json?     @map("service_ids")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  usageLimit     Int?      @map("usage_limit")
  usageCount     Int       @default(0) @map("usage_count")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  salon           Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  campaignRequest SmsCampaignRequest? @relation("CampaignRequestPromo")

  @@index([salonId])
  @@index([code])
  @@map("promo_codes")
}

model SmsCampaignRequest {
  id             String                   @id @default(uuid())
  ownerId        String                   @map("owner_id")
  salonId        String                   @map("salon_id")
  promoCodeId    String?                  @unique @map("promo_code_id")
  campaignName   String                   @map("campaign_name")
  segment        String
  discountPct    Int                      @map("discount_pct")
  discountScope  String                   @map("discount_scope")
  serviceIds     Json?                    @map("service_ids")
  validFrom      DateTime?                @map("valid_from")
  validTo        DateTime?                @map("valid_to")
  message        String                   @db.Text
  scheduledAt    DateTime?                @map("scheduled_at")
  recipientCount Int                      @default(0) @map("recipient_count")
  receiptUrl     String?                  @map("receipt_url") @db.Text
  priceCents     Int                      @map("price_cents")
  status         SmsCampaignRequestStatus @default(PENDING)
  adminNote      String?                  @map("admin_note") @db.Text
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  owner     User       @relation("OwnerCampaignRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  promoCode PromoCode? @relation("CampaignRequestPromo", fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([salonId])
  @@index([status])
  @@map("sms_campaign_requests")
}
