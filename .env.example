NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL="mysql://root:password@localhost:3306/salon_app"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m

LOG_LEVEL=debug

# Comma-separated origins for CORS (optional). Include your Vite dev port.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Registration payment (feature 002) ───────────────────────────────────────
# true = owners must upload a payment receipt to register. Keep false until the new frontend is deployed.
REGISTRATION_RECEIPT_REQUIRED=false

# ── SMSlenz (https://smslenz.lk) ──────────────────────────────────────────────
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=SMSlenzDEMO
